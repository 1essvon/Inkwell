/* ==========================================================
   INKWELL DESIGN SYSTEM
   01_typography.qss

   Typography hierarchy only.
   Color fallbacks here are for non-paper themes (dark).
   Ink & Paper color overrides live in 12_paper_theme.qss.

   Scale:
     H1  — 30px / 700 / serif   → pageTitle, dashboardGreeting, dialogTitle
     H2  — 22px / 700 / serif   → detailTitle, emptyTitle
     H3  — 17px / 600 / sans    → toolbarTitle, noteCardTitle
     H4  — 15px / 600 / sans    → cardTitle, bookTitle
     body— 14px / 400 / sans    → (inherited from QWidget)
     sm  — 13px / 400 / sans    → pageSubtitle, bookAuthor, secondary text
     xs  — 12px / 400 / sans    → caption, muted, badge
========================================================== */


/* ==========================================================
   H1 — PAGE & DIALOG TITLES
   Serif for editorial weight.
========================================================== */

QLabel#pageTitle,
QLabel#dashboardGreeting,
QLabel#dialogTitle {

    font-family: "Georgia", "Times New Roman", serif;

    font-size: 30px;

    font-weight: 700;

    color: #FFFFFF;
}


/* ==========================================================
   H2 — SECTION & DETAIL TITLES
   Serif, slightly smaller.
========================================================== */

QLabel#detailTitle,
QLabel#emptyTitle {

    font-family: "Georgia", "Times New Roman", serif;

    font-size: 22px;

    font-weight: 700;

    color: #FFFFFF;
}


/* ==========================================================
   H3 — TOOLBAR / CARD SECTION TITLES
   Sans-serif, medium weight.
========================================================== */

QLabel#toolbarTitle,
QLabel#noteCardTitle,
QLabel#sectionTitle,
QLabel#scratchpadCardTitle {

    font-size: 17px;

    font-weight: 600;

    color: #FFFFFF;
}


/* ==========================================================
   H4 — CARD LABELS & BOOK TITLES
   Sans-serif, semi-bold.
========================================================== */

QLabel#cardTitle {

    font-size: 14px;

    font-weight: 600;

    color: #B8B8B8;
}

QLabel#bookTitle {

    font-size: 15px;

    font-weight: 600;

    color: #FFFFFF;
}

QLabel#quoteCardBook {

    font-size: 13px;

}

QLabel#scratchpadCardUpdated {

    font-size: 12px;

}


/* ==========================================================
   CARD VALUE — Metric / stat numbers
   Serif for warmth; large, bold.
========================================================== */

QLabel#cardValue {

    font-family: "Georgia", "Times New Roman", serif;

    font-size: 28px;

    font-weight: 700;

    color: #FFFFFF;
}

QLabel#cardIcon {

    font-size: 20px;
}


/* ==========================================================
   PAGE / DASHBOARD SUBTITLE
   Small body, muted.
========================================================== */

QLabel#pageSubtitle,
QLabel#dashboardSubtitle {

    font-size: 13px;

    color: #9D9D9D;
}


/* ==========================================================
   SECTION LABEL
   All-caps, spaced, small — editorial section dividers.
========================================================== */

QLabel#sectionLabel {

    font-size: 11px;

    font-weight: 700;

    color: #8A8A8A;
}


/* ==========================================================
   EYEBROW TEXT
   Micro label above a heading — editorial accent.
========================================================== */

QLabel#eyebrowText {

    font-size: 10px;

    font-weight: 700;

    color: #8A8A8A;
}


/* ==========================================================
   BOOK METADATA
========================================================== */

QLabel#bookAuthor {

    font-size: 12px;

    color: #9C9C9C;
}

QLabel#bookProgress {

    font-size: 12px;

    color: #6AA8FF;
}

QLabel#bookStatus {

    font-size: 12px;

    font-weight: 600;

    color: #4F8EF7;
}


/* ==========================================================
   SECONDARY & CAPTION TEXT
========================================================== */

QLabel#secondaryText {

    font-size: 13px;

    color: #B8B8B8;
}

QLabel#caption,
QLabel#captionText {

    font-size: 12px;

    color: #8A8A8A;
}
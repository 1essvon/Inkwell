/* ==========================================================
   INKWELL DESIGN SYSTEM
   00_base.qss

   Foundation styles only.
========================================================== */


/* ==========================================================
   APPLICATION
========================================================== */

QMainWindow {

    background-color: #1E1E1E;
}


/* ==========================================================
   GLOBAL WIDGET
   Body text: sans-serif, comfortable reading size.
   Per-hierarchy serif overrides are in 01_typography.qss.
   Theme-specific color overrides are in 12_paper_theme.qss.
========================================================== */

QWidget {

    color: #FFFFFF;

    font-size: 14px;

    font-family: "Inter", "Segoe UI", sans-serif;
}


/* ==========================================================
   LABEL RESET
========================================================== */

QLabel {

    background: transparent;

    border: none;
}


/* ==========================================================
   SCROLL AREA
========================================================== */

QScrollArea {

    border: none;

    background: transparent;
}

QScrollArea > QWidget > QWidget {

    background: transparent;
}


/* ==========================================================
   LIST WIDGET
========================================================== */

QListWidget {

    border: none;

    outline: none;

    background: transparent;
}